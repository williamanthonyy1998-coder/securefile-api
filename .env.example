BILLING_MODE=preview
# Root .env is used by local development scripts. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
PUBLIC_APP_DOMAIN=securefile.com
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@securefile.com
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=securefile
INBOUND_EMAIL_SECRET=replace-with-a-random-secret
CRON_SECRET=replace-with-a-random-secret
MAX_UPLOAD_MB=250
