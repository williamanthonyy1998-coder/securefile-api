{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/[...path].ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/[...path].ts"
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance/sweep",
      "schedule": "0 3 * * *"
    }
  ]
}
