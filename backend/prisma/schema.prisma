generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  EMPLOYEE
  CLIENT
}
enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}
enum ShareType {
  INTERNAL
  PUBLIC
}
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}
enum TaskStatus {
  PENDING
  STARTED
  PARTIALLY_COMPLETED
  COMPLETED
}
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum ResourceType {
  FILE
  FOLDER
}
enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}
enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITATION
}
enum FaxJobStatus {
  QUEUED
  SENDING
  SENT
  RECEIVED
  FAILED
}

enum FaxDirection {
  OUTBOUND
  INBOUND
}

enum FileSource {
  UPLOAD
  SCAN
  FAX
}

model Company {
  id String @id @default(cuid())
  name String
  slug String @unique
  contactEmail String
  businessIndustry String?
  businessDescription String?
  logoUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  storageLimitGb Float @default(10)
  storageUsedBytes BigInt @default(0)
  users User[]
  folders Folder[]
  files File[]
  shares Share[]
  requests AccessRequest[]
  approvals Approval[]
  tasks Task[]
  messages Message[]
  groups Group[]
  notifications Notification[]
  faxLines FaxLine[]
  faxJobs FaxJob[]
  auditLogs AuditLog[]
  subscription Subscription?
  emails EmailMessage[]
}

model User {
  id String @id @default(cuid())
  companyId String?
  email String @unique
  uniqueName String
  passwordHash String?
  role Role
  status UserStatus @default(INVITED)
  emailVerifiedAt DateTime?
  personalFolderAllowed Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company? @relation(fields:[companyId],references:[id],onDelete:Cascade)
  ownedFiles File[] @relation("FileOwner")
  ownedFolders Folder[] @relation("FolderOwner")
  ownedShares Share[] @relation("ShareOwner")
  receivedShares Share[] @relation("ShareRecipient")
  notifications Notification[]
  faxLine FaxLine?
  faxJobs FaxJob[]
  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks Task[] @relation("TaskCreator")
  createdGroups Group[] @relation("GroupCreator")
  sentMessages Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageRecipient")
  requestedAccessRequests AccessRequest[] @relation("AccessRequester")
  targetedAccessRequests AccessRequest[] @relation("AccessTarget")
  requestedApprovals Approval[] @relation("ApprovalRequester")
  assignedApprovals Approval[] @relation("ApprovalApprover")
  auditLogs AuditLog[]
  groupMemberships GroupMember[]
  tokens VerificationToken[]
  sentEmails EmailMessage[] @relation("EmailSender")
  receivedEmails EmailMessage[] @relation("EmailRecipient")
}

model VerificationToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  type TokenType
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,type])
  @@index([expiresAt])
}

model Folder {
  id String @id @default(cuid())
  companyId String
  ownerId String?
  parentId String?
  name String
  isPersonal Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  owner User? @relation("FolderOwner",fields:[ownerId],references:[id],onDelete:SetNull)
  parent Folder? @relation("FolderTree",fields:[parentId],references:[id],onDelete:SetNull)
  children Folder[] @relation("FolderTree")
  files File[]
  shares Share[]
  accessRequests AccessRequest[] @relation("AccessRequestFolder")
  tasks Task[] @relation("TaskFolder")
  @@index([companyId,parentId])
  @@index([companyId,ownerId,isPersonal])
}

model File {
  id String @id @default(cuid())
  companyId String
  ownerId String?
  folderId String?
  name String
  storageKey String
  mimeType String
  sizeBytes BigInt
  checksum String?
  source FileSource @default(UPLOAD)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  owner User? @relation("FileOwner",fields:[ownerId],references:[id],onDelete:SetNull)
  folder Folder? @relation(fields:[folderId],references:[id],onDelete:SetNull)
  shares Share[]
  accessRequests AccessRequest[] @relation("AccessRequestFile")
  tasks Task[] @relation("TaskFile")
  faxJobs FaxJob[]
  versions FileVersion[]
  @@index([companyId,name])
  @@index([companyId,folderId])
}

model FileVersion {
  id String @id @default(cuid())
  fileId String
  storageKey String
  sizeBytes BigInt
  mimeType String
  createdAt DateTime @default(now())
  file File @relation(fields:[fileId],references:[id],onDelete:Cascade)
}

model Share {
  id String @id @default(cuid())
  companyId String
  fileId String?
  folderId String?
  ownerId String
  recipientId String?
  type ShareType @default(INTERNAL)
  publicTokenHash String? @unique
  canView Boolean @default(true)
  canDownload Boolean @default(false)
  canUpload Boolean @default(false)
  canEdit Boolean @default(false)
  canDelete Boolean @default(false)
  canShare Boolean @default(false)
  passwordHash String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  file File? @relation(fields:[fileId],references:[id],onDelete:Cascade)
  folder Folder? @relation(fields:[folderId],references:[id],onDelete:Cascade)
  owner User @relation("ShareOwner",fields:[ownerId],references:[id],onDelete:Cascade)
  recipient User? @relation("ShareRecipient",fields:[recipientId],references:[id],onDelete:Cascade)
  @@index([companyId,recipientId])
  @@index([companyId,fileId])
  @@index([companyId,folderId])
}

model AccessRequest {
  id String @id @default(cuid())
  companyId String
  requesterId String
  targetUserId String?
  fileId String?
  folderId String?
  requestedName String
  requestedType ResourceType
  note String?
  canDownload Boolean @default(false)
  status RequestStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  requester User @relation("AccessRequester",fields:[requesterId],references:[id],onDelete:Cascade)
  targetUser User? @relation("AccessTarget",fields:[targetUserId],references:[id],onDelete:SetNull)
  file File? @relation("AccessRequestFile",fields:[fileId],references:[id],onDelete:Cascade)
  folder Folder? @relation("AccessRequestFolder",fields:[folderId],references:[id],onDelete:Cascade)
  approval Approval?
  @@index([companyId,status])
}

model Approval {
  id String @id @default(cuid())
  companyId String
  requesterId String
  approverId String
  accessRequestId String? @unique
  fileId String?
  folderId String?
  canDownload Boolean @default(false)
  status RequestStatus @default(PENDING)
  note String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  requester User @relation("ApprovalRequester",fields:[requesterId],references:[id],onDelete:Cascade)
  approver User @relation("ApprovalApprover",fields:[approverId],references:[id],onDelete:Cascade)
  accessRequest AccessRequest? @relation(fields:[accessRequestId],references:[id],onDelete:SetNull)
  @@index([companyId,status])
}

model Task {
  id String @id @default(cuid())
  companyId String
  assigneeId String
  createdById String
  title String
  description String?
  fileId String?
  folderId String?
  file File? @relation("TaskFile",fields:[fileId],references:[id],onDelete:SetNull)
  folder Folder? @relation("TaskFolder",fields:[folderId],references:[id],onDelete:SetNull)
  startPage Int?
  endPage Int?
  priority TaskPriority @default(MEDIUM)
  status TaskStatus @default(PENDING)
  dueAt DateTime?
  solutionKey String?
  deletedAt DateTime?
  lastReminderAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  assignee User @relation("TaskAssignee",fields:[assigneeId],references:[id],onDelete:Cascade)
  createdBy User @relation("TaskCreator",fields:[createdById],references:[id],onDelete:Cascade)
  @@index([companyId,status,dueAt])
}

model Group {
  id String @id @default(cuid())
  companyId String
  createdById String?
  name String
  createdAt DateTime @default(now())
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  createdBy User? @relation("GroupCreator",fields:[createdById],references:[id],onDelete:SetNull)
  members GroupMember[]
  messages Message[]
}

model GroupMember {
  id String @id @default(cuid())
  groupId String
  userId String
  createdAt DateTime @default(now())
  group Group @relation(fields:[groupId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([groupId,userId])
}

model Message {
  id String @id @default(cuid())
  companyId String
  senderId String
  recipientId String?
  groupId String?
  body String
  createdAt DateTime @default(now())
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  sender User @relation("MessageSender",fields:[senderId],references:[id],onDelete:Cascade)
  recipient User? @relation("MessageRecipient",fields:[recipientId],references:[id],onDelete:SetNull)
  group Group? @relation(fields:[groupId],references:[id],onDelete:SetNull)
  @@index([companyId,createdAt])
}

model FaxLine {
  id String @id @default(cuid())
  companyId String
  userId String @unique
  phoneNumber String @unique
  provider String @default("PHAXIO")
  providerRef String?
  countryCode Int?
  areaCode Int?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([companyId,active])
}

model FaxJob {
  id String @id @default(cuid())
  companyId String
  userId String
  direction FaxDirection @default(OUTBOUND)
  status FaxJobStatus @default(QUEUED)
  recipientNumber String?
  senderNumber String?
  fileId String?
  provider String @default("PHAXIO")
  providerRef String?
  pages Int?
  errorMessage String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  file File? @relation(fields:[fileId],references:[id],onDelete:SetNull)
  @@index([companyId,status,createdAt])
  @@index([userId,createdAt])
  @@index([providerRef])
}

model Notification {
  id String @id @default(cuid())
  companyId String?
  userId String
  title String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  company Company? @relation(fields:[companyId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,readAt,createdAt])
}

model Subscription {
  id          String   @id @default(cuid())
  companyId   String   @unique
  planCode    String   @default("CUSTOM")
  users       Int
  storageGb   Float
  months      Int
  priceCents  Int
  status      SubscriptionStatus
  startsAt    DateTime
  expiresAt   DateTime
  provider    String
  providerRef String?
  stripeCustomerId String?
  stripeSubscriptionId String?
  billingInterval String @default("month")
  cancelAtPeriodEnd Boolean @default(false)
  addons      Json?
  pendingPlanCode String?
  pendingUsers Int?
  pendingStorageGb Float?
  pendingMonths Int?
  pendingPriceCents Int?
  pendingAddons Json?
  pendingCheckoutId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id String @id @default(cuid())
  companyId String?
  actorId String?
  action String
  entity String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  company Company? @relation(fields:[companyId],references:[id],onDelete:Cascade)
  actor User? @relation(fields:[actorId],references:[id],onDelete:SetNull)
  @@index([companyId,createdAt])
}

enum EmailDirection {
  SENT
  RECEIVED
}

model EmailMessage {
  id String @id @default(cuid())
  companyId String
  senderId String?
  recipientId String?
  recipientEmail String
  subject String
  body String
  direction EmailDirection @default(SENT)
  createdAt DateTime @default(now())
  company Company @relation(fields:[companyId],references:[id],onDelete:Cascade)
  sender User? @relation("EmailSender",fields:[senderId],references:[id],onDelete:SetNull)
  recipient User? @relation("EmailRecipient",fields:[recipientId],references:[id],onDelete:SetNull)
  @@index([companyId,createdAt])
  @@index([recipientId,createdAt])
  @@index([senderId,createdAt])
}

model PaymentEvent {
  id String @id @default(cuid())
  provider String
  eventId String @unique
  eventType String
  createdAt DateTime @default(now())
}
