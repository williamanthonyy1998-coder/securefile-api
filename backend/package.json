{
  "name": "securefile-api",
  "version": "1.0.0",
  "scripts": {
  "dev": "prisma generate --schema prisma/schema.prisma && tsx watch src/server.ts",
  "build": "prisma generate --schema prisma/schema.prisma && tsc",
  "start": "node dist/server.js",
  "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
  "postinstall": "prisma generate --schema prisma/schema.prisma"
},


  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "prisma": "^6.19.3",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
